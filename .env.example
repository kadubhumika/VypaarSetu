# Postgres Configuration
COMPOSE_PROJECT_NAME=vyapaarsetu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=vyapaarsetu
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/vyapaarsetu

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# JWT Configuration
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# OTP Configuration
OTP_TTL_SECONDS=300

# SMTP Configuration (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Twilio Configuration (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Google OAuth Configuration
GOOGLE_CLIENT_ID=

# Application Run Command
APP_CMD="uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
